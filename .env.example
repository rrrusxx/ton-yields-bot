# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram channel username (with @) or numeric ID
# Example: @ton_yields_daily or -1001234567890
TELEGRAM_CHANNEL_ID=@your_channel_here

# Optional: toncenter API key (free, from @tonapibot on Telegram) for the on-chain
# engine: 10 requests per second instead of 1. Leave empty to run without it.
# Spaces and line breaks around the key are trimmed. A key toncenter refuses, or
# one with a line break, a space or a non-Latin character inside, is dropped with
# a warning and the run goes on without it.
TONCENTER_API_KEY=

# Optional: the post format. "classic" (default) is the Telegram HTML post that
# the channel's web page (t.me/s) shows in full; "rich" sends a rich message
# (tables, collapsible sections) that the web page shows only as
# "Please open Telegram to view this post".
POST_FORMAT=classic

# Optional: the weekly card. "monday" (default) after Monday's post, "off"
# never, "always" after every post (once per day and channel; for tests).
WEEKLY_CARD=monday
